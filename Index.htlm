<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Florence Insights | Florence.ai</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 40px; background: #0e1117; color: #fff; }
        .card { background: #161b22; padding: 24px; border-radius: 8px; border: 1px solid #30363d; max-width: 800px; margin: 0 auto; }
        h1 { color: #58a6ff; }
        button { background: #238636; color: white; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-weight: bold; }
        button:hover { background: #2ea043; }
        input { margin-bottom: 20px; }
        pre { background: #0d1117; padding: 12px; border-radius: 6px; overflow-x: auto; }
    </style>
</head>
<body>

<div class="card">
    <h1>⚡ Florence Insights</h1>
    <p>Upload a 1M+ row dataset to process with the DuckDB engine.</p>
    
    <input type="file" id="fileInput" accept=".csv" />
    <br>
    <button onclick="uploadDataset()">Process Dataset</button>

    <div id="results" style="margin-top: 30px;"></div>
</div>

<script>
async function uploadDataset() {
    const fileInput = document.getElementById('fileInput');
    const resultsDiv = document.getElementById('results');
    
    if (!fileInput.files[0]) {
        alert("Please select a CSV file.");
        return;
    }

    resultsDiv.innerHTML = "<p>⏳ Processing in DuckDB backend...</p>";

    const formData = new FormData();
    formData.append("file", fileInput.files[0]);

    try {
        // Points directly to your Python API service
        const response = await fetch('/analyze', {
            method: 'POST',
            body: formData
        });

        const data = await response.json();
        
        if (data.status === "success") {
            resultsDiv.innerHTML = `
                <h3>Analysis Results</h3>
                <p><strong>Total Rows:</strong> ${data.total_rows.toLocaleString()}</p>
                <p><strong>Detected Columns:</strong> ${data.columns.join(", ")}</p>
                <h4>Data Sample (First 10 Rows):</h4>
                <pre>${JSON.stringify(data.preview, null, 2)}</pre>
            `;
        } else {
            resultsDiv.innerHTML = `<p style="color: #f85149;">Error: ${data.message}</p>`;
        }
    } catch (err) {
        resultsDiv.innerHTML = `<p style="color: #f85149;">Failed to connect to processing engine.</p>`;
    }
}
</script>

</body>
</html>
